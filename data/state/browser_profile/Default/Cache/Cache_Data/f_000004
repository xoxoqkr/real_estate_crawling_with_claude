//240524 lyh 엑셀파일 생성다운시 필요한 스크립드 로드
var xlsxLoaded = false;
var fileSaverLoaded = false;

function loadScripts(callback) {
    if (typeof XLSX !== 'undefined' && typeof XLSX.utils !== 'undefined') {
        if (fileSaverLoaded) {
            callback();
            return;
        }
        loadFileSaver(callback); // XLSX가 로드되었지만 FileSaver가 로드되지 않은 경우
    } else {
        // XLSX가 로드되지 않은 경우
        var xlsxScript = document.createElement('script');
        xlsxScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js';
        xlsxScript.onload = function () {
            xlsxLoaded = true;
            loadFileSaver(callback); // XLSX 로드 후 FileSaver 로드
        };
        document.head.appendChild(xlsxScript);
    }
}

// 240524 lyh 종합검색과 컬럼이 다른 검색리스트 엑셀화
function loadFileSaver(callback) {
    if (typeof saveAs !== 'undefined') {
        callback();
        return;
    }
    // FileSaver가 로드되지 않은 경우
    var fileSaverScript = document.createElement('script');
    fileSaverScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js';
    fileSaverScript.onload = function () {
        fileSaverLoaded = true;
        callback();
    };
    document.head.appendChild(fileSaverScript);
}

function exportTableToCSV() {
    loadScripts(function () {
        // 변환 함수를 정의합니다.
        function s2ab(s) {
            var buf = new ArrayBuffer(s.length);
            var view = new Uint8Array(buf);
            for (var i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
            return buf;
        }
        
            // 원본 테이블을 선택합니다.
            var table = document.querySelector(".tbl_result table");

            // 새로운 테이블을 만듭니다.
            var newTable = document.createElement('table');
            var rows = table.querySelectorAll('tr');

			var idx = 0
			var checker = false
            rows.forEach(function(row) {
				if(idx%2 == 0){
					checker = true
				}else{
					checker = false 
				}
                var newRow = document.createElement('tr');
                var cells = row.querySelectorAll('th, td');
                for (var i = 0; i < cells.length; i++) { // 첫 번째 열을 건너뜁니다.
                    if(checker && (i == 0)){
						continue
					}
					if(checker && (i == 7)){
						continue
					}
					if(!checker && (i == 3)){
						continue
					}
					
					var newCell = cells[i].cloneNode(true);        
                    newRow.appendChild(newCell);
                }
                newTable.appendChild(newRow);
				idx += 1
            });

            // 새로운 테이블을 워크북으로 변환
            var wb = XLSX.utils.table_to_book(newTable, { sheet: "스피드옥션" });
       
        var ws = wb.Sheets["스피드옥션"];
        var range = XLSX.utils.decode_range(ws['!ref']);		

        // 열 너비 계산
        var colWidths = [];
        for (var C = range.s.c; C <= range.e.c; ++C) {
            var maxWidth = 7; // 최소 열 너비
            for (var R = range.s.r; R <= range.e.r; ++R) {
                var cellAddress = XLSX.utils.encode_cell({ r: R, c: C });
                var cell = ws[cellAddress];
                if (cell && cell.v) {
                    var cellValue = cell.v.toString();
                    maxWidth = Math.max(maxWidth, cellValue.length + 1); // 셀 값의 길이로 너비 설정
                }
            }
            colWidths.push({ wch: maxWidth });
        }
        ws['!cols'] = colWidths;

        // 워크북을 바이너리 데이터로 변환
        var wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'binary' });

        // 엑셀 파일로 저장
        saveAs(new Blob([s2ab(wbout)], { type: "application/octet-stream" }), getXlsxFileName());
    });
}

// 240524 lyh 엑셀파일 이름 설정
function getXlsxFileName  (){
	let today = new Date();                 
	// 년도
	let year = today.getFullYear();                 
	// 월
	let month = (today.getMonth() + 1).toString().padStart(2, '0');                  
	// 일
	let day = today.getDate().toString().padStart(2, '0');                 
	// yyyymmddconst 
	yyyymmdd = `${year}-${month}-${day}`;

	return yyyymmdd+'_'+today.getTime()+'.xlsx';
}


