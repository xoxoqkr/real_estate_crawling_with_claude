});

function searchSubmit(){
	var eventno1 = $('#eventno1').val();
	var eventno2 = $('#eventno2').val();

	if (!eventno2) {
		$('#eventno2').focus();
		return false;
	}
		
	var url = "/search/sub/!/auction/01";

	$("#top_search").attr('method', 'get');
	$("#top_search").attr('action', url);
	$("#top_search").attr('onsubmit', '');
	$("#top_search").submit();
}

function searchKeyUp(){
	if(event.keyCode === 13){
		searchSubmit()
	}
}
