function add_interest() {
	var checked = $('.tbl_result input[type=checkbox]:checked');
	if(!$(checked).length){
		alert('최소 1건 이상 선택해야 합니다.');
		return false;
	}
	
	if($(checked).length == 1){
		var token
		var el_data
		$.each(checked, function(i, obj){
			el_data = $(obj).closest('tr').data()
			token = el_data.courtno+"|"+el_data.eventno+"|"+el_data.eventno2+"|"+el_data.objno
		})
		window.open('/pop/open/!/wish/edit?token='+token,'viewtop','width=550,height=650');
	}else{
		var data = [];
		$.each(checked, function(i,obj) {
			data[i] = $(obj).closest('tr').data();
		});
		speedjs.ajax_event('post', 'search@add_interest.ajax', {'data':data},':alert');
	}
}

