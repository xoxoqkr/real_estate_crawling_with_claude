# 브이월드 키는 채워 두었습니다. SA_ID, SA_PW와 WORK_DIR을 확인하세요. (.env는 다른 사람과 공유하지 마세요)

# 브이월드 인증키 (https://www.vworld.kr → 인증키 발급, 무료)
VWORLD_KEY=DB00728E-83F3-49F8-BD02-C24E38BA80C3
# 2D데이터 API(필지 경계)는 이 값이 없으면 '인증키 정보가 올바르지 않습니다' 오류가 남
VWORLD_DOMAIN=http://localhost

# 작업 폴더. 아래 4개 폴더를 따로 정하지 않으면 이 폴더 아래에 만들어집니다.
WORK_DIR=C:\Users\xoxoq\Downloads\경매서류_claude\재개발매칭
# INPUT_DIR=...   스피드옥션 엑셀을 넣는 폴더 (기본: WORK_DIR\input)
# ZONE_DIR=...    정비구역 SHP/GeoJSON 폴더 (기본: WORK_DIR\zones)
# OUTPUT_DIR=...  결과 엑셀 폴더 (기본: WORK_DIR\output)
# STATE_DIR=...   좌표 캐시·신규 판정 기록 (기본: WORK_DIR\state)

# 대상 구. 비우면 서울 전체
DISTRICTS=광진구,관악구

# 구역 밖이지만 이 거리(m) 안이면 '경계근접'으로 표시
NEAR_METERS=50
# 1이면 필지 경계(연속지적도)로 판정, 0이면 주소 좌표 한 점으로 판정
USE_PARCEL_POLYGON=1
# 1이면 처리한 엑셀을 input\처리완료\날짜 폴더로 옮김
ARCHIVE_INPUT=1
# 구역 파일에 좌표계(.prj)가 없을 때 가정할 좌표계
ZONE_DEFAULT_CRS=EPSG:5186

# 스피드옥션 자동 로그인용 (sa_collect.py). 비워 두면 --headed로 띄운 창에서 직접 로그인
SA_ID=
SA_PW=

# 매칭된 물건을 스피드옥션 관심경매물건에 저장 (1: 저장, 0: 안 함)
SAVE_INTEREST=1
# 저장 폴더코드: 100 박태준, 5 재개발, 6 재건축, 98 기타
INTEREST_FOLDER=100
# 저장할 판정 (쉼표 구분). 경계근접도 넣으려면: 구역안,구역걸침,경계근접
INTEREST_JUDGES=구역안,구역걸침
# 중요도 별 개수 (0~5)
INTEREST_STAR=0

# 서울 의제처리구역(UPIS_C_UQ181)에서 쓸 유형 코드 앞자리. 12 정비구역, 18 가로주택·자율주택·소규모재건축, 51 재정비촉진지구, 64 시장정비구역
ZONE_TYPE_PREFIXES=UQ12,UQ18,UQ51,UQ64

# 관심물건 저장 때, 최근 고시가 이 연도보다 오래된 구역에만 걸린 물건은 뺌 (끝난 사업지일 가능성). 0이면 끄기
INTEREST_MIN_NOTICE_YEAR=2005
