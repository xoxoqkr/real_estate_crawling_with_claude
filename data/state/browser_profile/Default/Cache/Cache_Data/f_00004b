	var Idx = "";

	//본원
	var courtno = $('input[name=courtno]').val();
	var courtno2 = $('input[name=courtno2]').val();
	var courtNo_main = "";
	var courtNo_sub = "";
	var auction_result = false;

	if (courtNo_sub.length > 2) {
		courtno = courtNo_sub;
		$('input[name=courtno]').val(courtno);
		set_court_detail(courtNo_main, courtNo_sub);
	}
	else if (courtNo_main.length > 2) {
		courtno = courtNo_main;
		$('input[name=courtno]').val(courtno);
	}

	if (courtno) {
		//auction_result = true;
	} 
	
	//일정별 검색 결과 (캘린더 검색)
	//경매N계
	if (courtno2) {
		var fix_sell_date = $('input[name=fix_sell_date]').val(); 
		var next_sell_date = $('input[name=next_sell_date]').val();
		//매각기일 시작
		if (fix_sell_date) {
			$('#sell_yyyymmdd_ss').val(fix_sell_date);
		}
		//매각기일 종료일
		if (next_sell_date) {
			$('#sell_yyyymmdd_ee').val(next_sell_date);
		}
	}
	

	if (topsearch) {
		//console.log();
		//auction_result = true;

	}

	//저장 검색 체크
	if (Idx) {

		if (courtNo_main != "00" || courtNo_main != "") {
			//set_court2('searchform', courtNo_main);
			set_court(courtNo_main);
			$("#courtNo_main").val(courtNo_main).prop('selected', true);
		}

		if (courtNo_sub != "00" || courtNo_sub != "") {
			$("#courtNo_sub").val(courtNo_sub).prop('selected', true);
		}

		$('.use').show();


		auction_result = true;
	}

	// 검색하기 btn
	$('a.blue').click(function() {
		$("#lastresultcode_new").val('');
		$("#usagecode_new").val('');
		$("#Idx").val('default')
		$("#searchform input[name=gubun]").val('')
		getpage(1);
		return false;
	});

	//주소
	var addr_url = SA_URL + speedjs.to_ajax('html','main@address.ajax');
	var addr1 = "0";
	var addr2 = "0";
	var addr3 = "0"; 
	var addr_view_id = '';
	var addr_params = {};

		if (addr1) {
			$("#addr1").val(addr1);

			addr_view_id = '#addr2';
			addr_params = {
				'addr1': addr1,
				'addr1_2': addr2,
			};
			//console.log(addr_params);
			$(addr_view_id).load(addr_url, addr_params);
		}
		if (addr2) {
			$("#addr2").val(addr2);

			addr_view_id = '#addr3';
			addr_params = {
				'addr2': addr2,
				'addr2_3': addr3,
			};
			$(addr_view_id).load(addr_url, addr_params);
		}
		if (addr3) {
			$("#addr3").val(addr3);
		}

	if (ezsearch) {
		if (courtno.length > 2) {
			$("#addr1").val(''); addr1 = '';
			$("#addr2").val(''); addr2 = '';
			$("#addr3").val(''); addr3 = '';
		} else {
			$("input[name=courtno]").val('');
		}

		//console.log($("#searchform").serializeArray().filter(isNotEmpty));
		auction_result = true;
	} 

	if (auction_result)
	{
		getpage(1);
	}

	//조건저장
	$(".btn_mark").click(function(e) {
		e.preventDefault();
		$("#title").val('');
