// 인쇄
function f_print(target){
    var initBody = document.body.innerHTML;
    window.onbeforeprint = function(){
        // target는 인쇄하고자 하는 영역의 tag를 말합니다.( 필수 )
        document.body.innerHTML = $(target).html();
    }
    window.onafterprint = function(){
        document.body.innerHTML = initBody;
    }
    window.print();
}

// 신규인쇄
function f_print_NEW(target, typeName, Mc){
    checkList = [];
    checkBoxs = $(target).find('input[type=checkbox]');
    if(checkBoxs){
        $.each(checkBoxs, function (idx, el) {
            if($(el).prop('checked')){
                checkList.push(idx);
            }
        });
    }

    // 관심물건 인쇄시 해당문구 출력되어 디자인 망가지는 부분떄문에 숨김처리
    $(target).find('.interest_parent').hide();

    localStorage.setItem('printData', $(target).html());
    localStorage.setItem('printType', typeName);
    localStorage.setItem('printCheckList', checkList.join(','));
	localStorage.setItem('member_code', Mc);

    // 숨긴 요소 다시 보이기
    $(target).find('.interest_parent').show();

    window.open('/pub/html/auction_print.html', '스피드옥션 인쇄 페이지', 'scrollbars=no, width=940, top=0, left=0, height=1000');
}

