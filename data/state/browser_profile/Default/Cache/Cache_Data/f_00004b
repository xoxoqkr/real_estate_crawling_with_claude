		var gubun = "F";
		save_search(gubun);
	});

	// 페이징 메서드
	function getpage(page){

		console.log("ASd")
		let courtSub = $("#courtNo_sub :selected").val()
		if(!(courtSub == '99' || courtSub === undefined)){
			localStorage.setItem("tmpCourtSub", courtSub)
		}

		$("#page").val(page);
		//$(".use").hide();
		$(".search_mark").hide();
		$('#auction_result').html( loading_bar() ).delay(3000);
		scroll_top('#auction_result', 45);

		var params = $('#searchform').serializeArray().filter(isNotEmpty);

		if (addr2 && !$("#addr2").val()) {
			params.push({'name':'region_code2','value':addr2});
		}
		
		if (addr3 && !$("#addr3").val()) {
			params.push({'name':'region_code3','value':addr3});
		}
		//메인에서 들어온 검색을 조치하고난 후 처리
		if (['calendar'].includes($("input[name=strcode]").val())) {
			$("input[name=strcode]").val("")
			$("input[name=fix_sell_date]").val("")
			$("input[name=next_sell_date]").val("")
			$("input[name=courtno2]").val("")
		}

		//console.log(params);
		speedjs.ajax_event('post', 'search@auction_result.ajax', params, '#auction_result');
		return false;
	}

	//현황용도 셀렉트 박스
	$(document).ready(function(){
		$("#useSingleSelectBox").change(function(){
			let group = $(this).find("option:selected").data("group")
			let id = $(this).find("option:selected").data("id")
			$("input[type='checkbox']").prop('checked',false)

			if(group !== undefined)
				$("#"+group).trigger('click')
			else if(id !== undefined)
				$("#"+id).prop('checked',true)
		})
	})
	// 공시가격 버튼 관련
	document.addEventListener("DOMContentLoaded", function () {
    const chk1 = document.getElementById("gongsipricechk1"); // 1억 이하
    const chk2 = document.getElementById("gongsipricechk2"); // 2억 이하
    const maxSel = document.querySelector("select[name='gongsipricemax']");
    const minSel = document.querySelector("select[name='gongsipricemin']");

    let suppressChangeEvent = false; // ✅ 변경 감지 억제 플래그

    function setPriceRange(minValue, maxValue) {
        suppressChangeEvent = true; // 🔒 이벤트 일시 무시 시작
        minSel.value = minValue;
        maxSel.value = maxValue;
        suppressChangeEvent = false; // 🔓 무시 해제
    }

    chk1.addEventListener("change", function () {
        if (chk1.checked) {
            chk2.checked = false;
            setPriceRange("0", "100000000");
        } else {
            setPriceRange("0", "99999999999999");
        }
    });

    chk2.addEventListener("change", function () {
        if (chk2.checked) {
            chk1.checked = false;
            setPriceRange("0", "200000000");
        } else {
            setPriceRange("0", "99999999999999");
        }
    });

    // ✅ 사용자 직접 조작일 때만 체크박스 해제
    minSel.addEventListener("change", function () {
        if (!suppressChangeEvent) {
            chk1.checked = false;
            chk2.checked = false;
        }
    });

    maxSel.addEventListener("change", function () {
        if (!suppressChangeEvent) {
            chk1.checked = false;
            chk2.checked = false;
        }
    });

	$("#special-btn").click(function(){
		$("#special-box").slideToggle()
	})
});
